# ---------------------------------------------------------------------------
# Smile Preview backend — environment variables
# Copy this file to ".env" for local development.
# In production (Render), set these under Dashboard > Environment instead
# of committing a .env file.
# ---------------------------------------------------------------------------

# Required. Your OpenAI API key (starts with "sk-"). Keep this secret —
# never expose it in frontend code or commit it to source control.
OPENAI_API_KEY=sk-your-openai-api-key-here

# Required. The exact origin(s) allowed to call this API, comma-separated.
# Use your live Squarespace domain(s). Include both the apex and www
# versions if your site answers on both. No trailing slash.
# Example: https://www.brightsmiledental.com,https://brightsmiledental.com
ALLOWED_ORIGINS=https://www.your-dental-site.com

# Optional. Port the server listens on. Render sets this automatically —
# only needed for local development. Defaults to 3000.
PORT=3000

# Optional. Node environment. Set to "production" on Render.
NODE_ENV=development

# Optional. Max upload size in megabytes. Defaults to 8.
MAX_UPLOAD_MB=8

# Optional. Requests allowed per IP per window on /generate. Defaults to 5.
RATE_LIMIT_MAX=5

# Optional. Rate limit window in minutes. Defaults to 15.
RATE_LIMIT_WINDOW_MIN=15

# Optional. OpenAI image model to use for edits. Defaults to gpt-image-1.
OPENAI_IMAGE_MODEL=gpt-image-1
